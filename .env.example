# xAI Grok API key — https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# YouTube OAuth2 credentials
# Obtain these by running: python scripts/setup_youtube_auth.py
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Optional: language for TTS (default: en)
TTS_LANGUAGE=en

# Optional: override video output directory (default: /tmp/video_output)
OUTPUT_DIR=/tmp/video_output
